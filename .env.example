# RPC endpoint for the Sepolia testnet (Alchemy, Infura, etc.)
SEPOLIA_RPC_URL=

# Private key of the deployer wallet (testnet only — never use a mainnet key)
PRIVATE_KEY=

# Optional: for contract verification on Etherscan
ETHERSCAN_API_KEY=

# NFT.Storage API key, used by scripts/uploadToIpfs.js and the frontend mint flow
# Get a free key at https://nft.storage
NFT_STORAGE_KEY=
