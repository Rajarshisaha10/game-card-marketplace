# Fill these in after running `npm run deploy:sepolia` (or deploy:localhost)
VITE_GAMECARD_ADDRESS=
VITE_MARKETPLACE_ADDRESS=

# Expected chain id the dApp should be connected to (11155111 = Sepolia, 31337 = local Hardhat node)
VITE_CHAIN_ID=11155111
VITE_CHAIN_NAME=Sepolia

# NFT.Storage API key used to upload card images + metadata JSON to IPFS from the mint form
VITE_NFT_STORAGE_KEY=

# Public IPFS gateway used to render ipfs:// images/metadata in the browser
VITE_IPFS_GATEWAY=https://nftstorage.link/ipfs/
